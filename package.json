{
  "name": "citegauge",
  "version": "0.1.0",
  "description": "Evidence-first GEO monitoring on Cloudflare Workers",
  "scripts": {
    "test": "node --env-file-if-exists=.env --test test/*.test.ts",
    "dev": "wrangler dev",
    "check": "tsc --noEmit && npm run check:lines",
    "deploy": "wrangler deploy",
    "check:lines": "node scripts/check-lines.mjs",
    "auth:admin": "node --env-file-if-exists=.env scripts/setup-admin.mjs",
    "db:local": "node scripts/db/local.mjs",
    "db:migrate": "wrangler d1 migrations apply DB",
    "build:ui": "node scripts/prepare-assets.mjs"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "@lobehub/icons-static-svg": "1.103.0",
    "@tailwindcss/cli": "^4.3.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "wrangler": "^4.160.1"
  },
  "repository": {
    "url": "https://github.com/xizhou0606/citegauge.git"
  },
  "dependencies": {
    "@ai-sdk/alibaba": "2.0.88",
    "@ai-sdk/anthropic": "4.0.102",
    "@ai-sdk/deepseek": "3.0.84",
    "@ai-sdk/google": "4.0.118",
    "@ai-sdk/moonshotai": "3.0.90",
    "@ai-sdk/openai": "4.0.115",
    "@ai-sdk/perplexity": "5.0.31",
    "@chat-adapter/slack": "4.45.0",
    "@chat-adapter/state-memory": "4.45.0",
    "@chat-adapter/telegram": "4.45.0",
    "ai": "7.0.170",
    "better-auth": "^1.7.22",
    "chart.js": "^4.6.1",
    "chat": "4.45.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eventsource-parser": "3.1.1",
    "lucide-react": "^1.75.0",
    "markdown-it": "15.0.3",
    "p-limit": "^7.3.3",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.7"
  }
}
